---
// Interactive demo of the assistant with a "how it thinks" trace under every reply.
// For now it runs a local scripted engine with fictional salon data; the next step
// is a rate-limited public demo endpoint on the kernel that returns the same trace.
---

<div class="chat-wrap" data-chat>
  <div class="chat card">
    <div class="top">
      <div class="who">
        <span class="ava" aria-hidden="true"><span></span></span>
        <div>
          <div class="name" data-name>Салон «Люмен»</div>
          <div class="status"><i></i><span data-status>ассистент WeReplyFirst · онлайн</span></div>
        </div>
      </div>
      <label class="think-toggle">
        <input type="checkbox" checked data-think />
        <span class="sw" aria-hidden="true"></span>
        <span class="lbl">Мысли</span>
      </label>
    </div>

    <div class="tabs" role="tablist" aria-label="Режим демо">
      <button role="tab" aria-selected="true" data-mode="client">Я клиент салона</button>
      <button role="tab" aria-selected="false" data-mode="product">Спросить про WeReplyFirst</button>
    </div>

    <div class="log" data-log aria-live="polite"></div>

    <div class="chips" data-chips></div>

    <form class="input" data-form>
      <input data-input type="text" placeholder="Напишите как клиент…" autocomplete="off" maxlength="200" aria-label="Сообщение ассистенту" />
      <button type="submit" aria-label="Отправить">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </button>
    </form>
  </div>

  <div class="owner" data-owner hidden>
    <div class="o-head">
      <span class="tg" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M9.8 15.6 9.6 19c.4 0 .6-.2.8-.4l2-1.9 4.1 3c.8.4 1.3.2 1.5-.7L21 5.6c.3-1.1-.4-1.6-1.2-1.3L3.6 10.5c-1.1.4-1.1 1-.2 1.3l4.2 1.3 9.7-6.1c.5-.3.9-.1.5.2"></path></svg>
      </span>
      <b>Telegram владельца</b><span class="o-time">сейчас</span>
    </div>
    <p class="o-text" data-owner-text></p>
    <div class="o-actions" data-owner-actions></div>
  </div>

  <p class="foot">Демо-сценарий: салон и его данные вымышленные.</p>
</div>

<script>
  type Route = "template" | "scenario" | "knowledge" | "llm" | "owner" | "pii";
  type Trace = { route: Route; label: string } | { k: string; v: string };
  type Reply = {
    trace: Trace[];
    text: string;
    chips?: string[];
    owner?: { text: string; answers: { label: string; reply: Reply }[] };
  };
  type Mode = "client" | "product";

  const ROUTE_LABEL: Record<Route, string> = {
    template: "Шаблон",
    scenario: "Сценарий",
    knowledge: "База знаний",
    llm: "Нейросеть",
    owner: "Владелец",
    pii: "PII-шлюз",
  };
  const r = (route: Route, label = ROUTE_LABEL[route]): Trace => ({ route, label });
  const kv = (k: string, v: string): Trace => ({ k, v });
  const ms = () => kv("время", `${Math.round(25 + Math.random() * 60)} мс`);

  // ---------- fictional salon ----------
  const SERVICES: Record<string, { name: string; price: string }> = {
    haircut: { name: "Стрижка женская", price: "8 000 ₸" },
    manicure: { name: "Маникюр с покрытием", price: "6 000 ₸" },
    color: { name: "Окрашивание", price: "от 25 000 ₸" },
  };
  type Slot = { t: string; m: string; at: string }; // at — "у Дины" (genitive)
  const DAYS: Record<string, { label: string; slots: Slot[] }> = {
    tomorrow: { label: "завтра", slots: [{ t: "18:00", m: "Айгерім", at: "Айгерім" }, { t: "19:30", m: "Дина", at: "Дины" }] },
    saturday: { label: "в субботу", slots: [{ t: "10:00", m: "Айгерім", at: "Айгерім" }, { t: "11:30", m: "Дина", at: "Дины" }] },
  };
  const LOAD: Record<string, string> = { Айгерім: "6 ч", Дина: "3,5 ч" };

  type Booking = {
    service?: string;
    day?: string;
    slot?: Slot;
    awaiting?: "service" | "slot" | "contact";
    done?: boolean;
    known?: boolean; // contact already given in this chat
    name?: string;
    moving?: Slot; // the slot being rescheduled
  };
  let b: Booking = {};

  const serviceOf = (s: string) =>
    /стрижк|подстри/.test(s) ? "haircut" : /маник|ногт/.test(s) ? "manicure" : /окраш|цвет|покрас/.test(s) ? "color" : undefined;
  const dayOf = (s: string) => (/суббот/.test(s) ? "saturday" : /завтр|вечер|сегодн/.test(s) ? "tomorrow" : undefined);

  const YES = /^(да|ага|давайте|конечно|ок|хорошо)([\s,.!]|$)/;
  const PHONE = /\+?\d[\d\s()-]{6,}\d/;

  // Final step of booking or moving: write to the CRM journal and confirm.
  function confirm(slot: Slot, day: string, service: string, trace: Trace[], name?: string, moved = false): Reply {
    b = { done: true, known: true, service, day, slot, name };
    return {
      trace: [...trace, kv("владельцу", "уведомление в Telegram"), ms()],
      text: `Готово${name ? `, ${name}` : ""}! ${moved ? "Перенесла запись" : "Записала вас"}: ${SERVICES[service].name.toLowerCase()}, ${DAYS[day].label} в ${slot.t}, мастер ${slot.m}. Если планы изменятся — напишите сюда, перенесу или отменю.`,
      chips: ["Перенесите, пожалуйста", "Отмените запись", "Можно скидку на день рождения?"],
    };
  }

  function nextBookingStep(extra: Trace[] = []): Reply {
    if (!b.service) {
      b.awaiting = "service";
      return {
        trace: [r("scenario"), kv("сценарий", "запись · шаг 1/4 — услуга"), ...extra, kv("нейросеть", "не вызывалась"), ms()],
        text: "С удовольствием запишу! На какую услугу?",
        chips: ["Стрижка женская", "Маникюр", "Окрашивание"],
      };
    }
    if (!b.slot) {
      b.day ??= "tomorrow";
      const d = DAYS[b.day];
      b.awaiting = "slot";
      return {
        trace: [
          r("scenario"),
          kv("сценарий", b.moving ? "перенос · выбор времени" : "запись · шаг 2/4 — время"),
          kv("услуга", SERVICES[b.service].name),
          ...extra,
          kv("журнал CRM", `свободно ${d.label}: ${d.slots.map((s) => s.t).join(", ")}`),
          ms(),
        ],
        text: `${cap(d.label)} свободно: ${d.slots.map((s) => `${s.t} у ${s.at}`).join(" и ")}. Какое время удобно?`,
        chips: [...d.slots.map((s) => `${s.t} у ${s.at}`), "Всё равно к кому"],
      };
    }
    const slot = b.slot;
    const day = b.day!;
    if (b.moving) {
      const from = b.moving;
      return confirm(slot, day, b.service, [
        r("scenario"),
        kv("сценарий", "перенос · подтверждено"),
        ...extra,
        kv("журнал CRM", `${from.t} → ${DAYS[day].label} ${slot.t} · ${slot.m}`),
        kv("контакт", "уже известен — не переспрашиваем"),
      ], b.name, true);
    }
    if (b.known) {
      return confirm(slot, day, b.service, [
        r("scenario"),
        kv("сценарий", "запись · подтверждено"),
        ...extra,
        kv("контакт", "уже известен — не переспрашиваем"),
        kv("журнал CRM", `создана запись · ${slot.m} · ${slot.t}`),
      ], b.name);
    }
    b.awaiting = "contact";
    return {
      trace: [r("scenario"), kv("сценарий", "запись · шаг 3/4 — контакт"), ...extra, kv("слот", `${slot.t} · ${slot.m}`), ms()],
      text: `Отлично, ${DAYS[day].label} в ${slot.t} у ${slot.at}. Как к вам обращаться? Имя и телефон, пожалуйста.`,
      chips: ["Айгерім, +7 701 234 56 78"],
    };
  }

  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  const birthday: Reply = {
    trace: [r("owner", "Ответ владельца"), kv("ответ", "«да, 10% в др»"), r("llm"), kv("задача", "переписать в тоне ассистента"), kv("нейросеть видит", "без личных данных"), ms()],
    text: "Хорошие новости: в день рождения у нас скидка 10% на все услуги. Покажите документ на ресепшене — мастер учтёт.",
    chips: ["Есть время завтра вечером?", "Сколько стоит стрижка?"],
  };
  const birthdayNo: Reply = {
    trace: [r("owner", "Ответ владельца"), kv("ответ", "«скидки нет, будет подарок»"), r("llm"), kv("задача", "переписать в тоне ассистента"), ms()],
    text: "Скидки на день рождения у нас нет, но в этот день мастер приготовит для вас небольшой подарок.",
    chips: ["Есть время завтра вечером?", "Сколько стоит стрижка?"],
  };

  const noBooking: Reply = {
    trace: [r("scenario"), kv("журнал CRM", "активных записей у клиента нет"), ms()],
    text: "У вас пока нет записи. Хотите записаться?",
    chips: ["Да, на завтра вечером", "Сколько стоит стрижка?"],
  };

  function clientReply(raw: string): Reply {
    const s = raw.toLowerCase().trim();

    // Contact step: a phone number is required, the name is optional.
    if (b.awaiting === "contact" && PHONE.test(raw)) {
      const first = raw.trim().split(/[\s,]+/)[0];
      const name = /^[A-ZА-ЯЁӘҒҚҢӨҰҮҺІ][^\d]*$/.test(first) ? first : undefined;
      return confirm(b.slot!, b.day!, b.service!, [
        r("pii"),
        kv("найдено", name ? "имя · телефон" : "телефон"),
        kv("нейросеть видит", name ? "«[ИМЯ], [ТЕЛЕФОН]»" : "«[ТЕЛЕФОН]»"),
        r("scenario"),
        kv("сценарий", "запись · шаг 4/4 — подтверждено"),
        kv("журнал CRM", `создана запись · ${b.slot!.m} · ${b.slot!.t}`),
      ], name);
    }

    if (/скидк|акци|день рожд|дешевле|промокод/.test(s)) {
      return {
        trace: [
          r("knowledge"),
          kv("поиск", "«скидка», «день рождения»"),
          kv("в данных", "ничего не найдено"),
          kv("правило", "скидки обещает только владелец"),
          r("owner", "Эскалация"),
          kv("действие", "выжимка → Telegram владельца"),
          ms(),
        ],
        text: "Хороший вопрос — уточню у администратора и вернусь с ответом прямо здесь, буквально пару минут.",
        owner: {
          text: "Клиент спрашивает: «Можно скидку на день рождения?» В прайсе скидок нет. Что ответить?",
          answers: [
            { label: "Да, 10% в день рождения", reply: birthday },
            { label: "Нет, но будет подарок", reply: birthdayNo },
          ],
        },
      };
    }

    if (/отмен/.test(s)) {
      if (!b.done || !b.slot) return noBooking;
      const old = b.slot;
      const day = DAYS[b.day!].label;
      b = { known: true, name: b.name };
      return {
        trace: [r("scenario"), kv("сценарий", "отмена записи"), kv("журнал CRM", `запись ${old.t} · ${old.m} отменена`), kv("владельцу", "уведомление об отмене"), ms()],
        text: `Отменила вашу запись ${day} в ${old.t}. Захотите прийти в другое время — напишите, подберу.`,
        chips: ["Запишите на субботу", "Сколько стоит стрижка?"],
      };
    }

    if (/перен|не смогу|не успева|другое время/.test(s)) {
      if (!b.done || !b.slot) return noBooking;
      b = { service: b.service, day: "saturday", moving: b.slot, known: true, name: b.name };
      return nextBookingStep([kv("текущая", `${b.moving!.t} · ${b.moving!.m}`)]);
    }

    if (/всё равно|все равно|любой|любому|без разницы/.test(s) && b.service && !b.slot) {
      b.day ??= "tomorrow";
      const slots = DAYS[b.day].slots;
      const pick = slots.reduce((a, c) => (parseFloat(LOAD[c.m].replace(",", ".")) < parseFloat(LOAD[a.m].replace(",", ".")) ? c : a));
      b.slot = pick;
      return nextBookingStep([r("scenario", "Распределение"), kv("загрузка", slots.map((x) => `${x.m} ${LOAD[x.m]}`).join(" · ")), kv("выбор", `${pick.m} — свободнее`)]);
    }

    if (b.awaiting === "slot" && b.day) {
      const slot = DAYS[b.day].slots.find((x) => s.includes(x.t) || s.includes(x.t.slice(0, 2)) || s.includes(x.m.toLowerCase().slice(0, 3)));
      if (slot) {
        b.slot = slot;
        return nextBookingStep();
      }
    }

    const svc = serviceOf(s);
    const day = dayOf(s);
    const wantsBooking = /запис|время|свобод|окошк|окно|есть ли/.test(s) || !!day;
    const yes = YES.test(s);

    // A finished booking never leaks its slot into the next one.
    if (b.done && (wantsBooking || yes || /голосов/.test(s))) b = { known: true, name: b.name };

    if (/голосов/.test(s)) {
      b.day = "saturday";
      b.service ??= "haircut";
      b.slot = undefined;
      return nextBookingStep([r("pii", "Распознавание речи"), kv("где", "свои серверы, наружу не уходит"), kv("текст", "«есть время в субботу утром на стрижку?»")]);
    }

    if (svc && (wantsBooking || b.awaiting === "service")) {
      b.service = svc;
      if (day) b.day = day;
      return nextBookingStep();
    }

    if (/сколько|цен|стоит|прайс|стоимост/.test(s)) {
      const one = svc ? SERVICES[svc] : SERVICES.haircut;
      if (svc && !b.slot) b.service = svc;
      return {
        trace: [r("template"), kv("намерение", "цена услуги · 0.97"), kv("прайс", `${one.name} — ${one.price}`), kv("нейросеть", "не вызывалась · 0 токенов"), ms()],
        text: svc
          ? `${one.name} — ${one.price}. Записать вас?`
          : "Стрижка женская — 8 000 ₸, мужская — 5 000 ₸, с укладкой — 11 000 ₸. Записать вас?",
        chips: b.awaiting === "contact" ? ["Айгерім, +7 701 234 56 78"] : ["Да, на завтра вечером", "Можно скидку на день рождения?"],
      };
    }

    if (wantsBooking || yes) {
      if (day && !b.slot) b.day = day;
      if (svc) b.service = svc;
      if (!b.service && yes) b.service = "haircut";
      return nextBookingStep();
    }

    if (svc) {
      b.service = svc;
      return nextBookingStep();
    }

    if (/работа|график|воскрес|часы|адрес|где вы|открыт/.test(s)) {
      return {
        trace: [r("template"), kv("намерение", "часы и адрес · 0.95"), kv("карточка бизнеса", "10:00–21:00 ежедневно"), kv("нейросеть", "не вызывалась"), ms()],
        text: "Работаем каждый день с 10:00 до 21:00, в воскресенье тоже. Мы на проспекте Абая, 150.",
        chips: ["Есть время завтра вечером?", "Сколько стоит стрижка?"],
      };
    }

    if (/привет|здравст|салам|сәлем|добрый/.test(s)) {
      return {
        trace: [r("template"), kv("намерение", "приветствие"), ms()],
        text: "Здравствуйте! Подскажу цены, свободное время и запишу к мастеру. Что вас интересует?",
        chips: ["Сколько стоит стрижка?", "Запишите на завтра вечером"],
      };
    }

    if (b.awaiting === "contact") {
      return {
        trace: [r("scenario"), kv("сценарий", "запись · шаг 3/4 — контакт"), kv("в сообщении", "телефона нет"), ms()],
        text: "Чтобы закрепить время, напишите, пожалуйста, имя и номер телефона.",
        chips: ["Айгерім, +7 701 234 56 78"],
      };
    }

    return {
      trace: [r("knowledge"), kv("поиск", "совпадений нет · 0.28"), kv("решение", "не выдумывать"), r("owner", "Эскалация"), kv("действие", "вопрос → Telegram владельца"), ms()],
      text: "Этого я точно не знаю, а выдумывать не буду. Уточню у администратора и вернусь с ответом здесь же.",
      chips: ["Сколько стоит стрижка?", "Запишите на завтра вечером"],
    };
  }

  // What WeReplyFirst does not do yet — answered straight, from the knowledge base.
  const LIMITS: [RegExp, string][] = [
    [/звон|звонк|позвон/, "Нет, я работаю только в переписке — звонить и принимать звонки не умею."],
    [/фото|картин|изображ|скрин/, "Фото клиентов я не распознаю — вежливо прошу описать вопрос словами. Голосовые понимаю."],
    [/рассыл/, "Массовые рассылки я не делаю — только отвечаю клиентам, которые написали сами."],
    [/whatsapp|ватсап|вотсап|instagram|инстаграм|max\b|макс/, "Сейчас клиенты пишут мне в Telegram. WhatsApp Business для клиентов — скоро; сложные вопросы владельцу я уже умею присылать в WhatsApp."],
    [/yclients|altegio|альтеджио|иклаентс|crm|црм/, "Подключаем ту систему записи, которой вы пользуетесь, — назовите её, и обсудим подключение на старте. Без CRM я тоже работаю."],
    [/оплат.*(клиент|услуг)|принима.*оплат|эквайр/, "Оплату от ваших клиентов я не принимаю — только записываю и отвечаю на вопросы."],
  ];

  function productReply(raw: string): Reply | "switch" {
    const s = raw.toLowerCase();
    if (/покажи|запиши|запишите|записать меня|как ты записываешь/.test(s)) return "switch";
    const limit = LIMITS.find(([re]) => re.test(s));
    if (limit)
      return {
        trace: [r("knowledge"), kv("статья", "«Чего WeReplyFirst пока не делает»"), kv("правило", "не обещать лишнего"), ms()],
        text: limit[1],
        chips: ["Что ты умеешь?", "Сколько стоит?"],
      };
    if (/стоит|цен|тариф|оплат|дорог|сколько/.test(s))
      return {
        trace: [r("template"), kv("намерение", "цена · 0.98"), kv("источник", "тарифы WeReplyFirst"), kv("нейросеть", "не вызывалась"), ms()],
        text: "25 000 ₸ в месяц — меньше 850 ₸ в день, все функции сразу. Первые 7 дней бесплатно, до 500 ответов клиентам. Отменить можно в любой момент.",
        chips: ["Как начать?", "А ты не наврёшь клиенту?"],
      };
    if (/навр|выдум|точн|chatgpt|gpt|ошиб|врёт|врет/.test(s))
      return {
        trace: [r("knowledge"), kv("статья", "«Почему не выдумывает цены»"), r("llm"), kv("задача", "ответить коротко по статье"), ms()],
        text: "Цены, адреса и запись я беру из ваших данных, а не из нейросети. Нейросеть нужна только для живого разговора и опирается на те же факты. Чего нет в данных — не обещаю, а спрашиваю у владельца.",
        chips: ["Куда уходят данные клиентов?", "Покажи запись"],
      };
    if (/казах|қазақ|язык|англ|english/.test(s))
      return {
        trace: [r("template"), kv("намерение", "языки"), kv("настройка", "язык ассистента"), ms()],
        text: "Иә, қазақша да сөйлеймін! Я мультиязычный: язык общения выбирается в настройках ассистента.",
        chips: ["Что ты умеешь?", "Сколько стоит?"],
      };
    if (/данн|персон|безопас|закон|приват|телефон/.test(s))
      return {
        trace: [r("knowledge"), kv("статья", "«Персональные данные»"), r("llm"), kv("задача", "ответить коротко по статье"), ms()],
        text: "Сначала спрашиваю у клиента согласие. Имена, телефоны и email заменяются метками ещё до нейросети — она их не видит. Голосовые распознаются на наших серверах. Работаем по закону РК «О персональных данных».",
        chips: ["Покажи запись", "Сколько стоит?"],
      };
    if (/начать|подключ|попроб|старт|настро|программист/.test(s))
      return {
        trace: [r("knowledge"), kv("статья", "«Как начать»"), kv("нейросеть", "не вызывалась"), ms()],
        text: "Три шага: регистрируетесь в кабинете, выбираете сферу — услуги и цены подтянем из вашей CRM, — и подключаете мессенджер. Программист не нужен, настроим вместе.",
        chips: ["Покажи запись", "Сколько стоит?"],
      };
    if (/уме|функц|можешь|что ты|возможн|зачем/.test(s))
      return {
        trace: [r("knowledge"), kv("статья", "«Что умеет ассистент»"), r("llm"), kv("задача", "сжать до 3 предложений"), ms()],
        text: "Отвечаю клиентам 24/7, называю цены из вашего прайса и сам записываю в CRM: подбираю время, переношу, отменяю. Понимаю голосовые. Сложный вопрос передаю владельцу и пересылаю клиенту ответ.",
        chips: ["Покажи запись", "Сколько стоит?"],
      };
    if (/привет|здравст|салам|сәлем/.test(s))
      return {
        trace: [r("template"), kv("намерение", "приветствие"), ms()],
        text: "Привет! Спросите что угодно о WeReplyFirst — или нажмите «Покажи запись», и я сыграю администратора салона.",
        chips: ["Что ты умеешь?", "Покажи запись"],
      };
    return {
      trace: [r("knowledge"), kv("поиск", "совпадений нет · 0.31"), kv("решение", "не выдумывать"), r("owner", "Эскалация"), kv("действие", "вопрос → команде WeReplyFirst"), ms()],
      text: "Точного ответа в моей базе нет — выдумывать не буду. Передам вопрос команде и вернусь с ответом. А пока могу показать, как записываю клиентов.",
      chips: ["Покажи запись", "Что ты умеешь?"],
    };
  }

  const GREETING: Record<Mode, Reply> = {
    client: {
      trace: [],
      text: "Здравствуйте! Это салон «Люмен». Подскажу цены, свободное время и запишу к мастеру. Чем помочь?",
      chips: ["Есть время завтра вечером?", "Сколько стоит стрижка?", "Голосовое сообщение", "Можно скидку на день рождения?"],
    },
    product: {
      trace: [],
      text: "Привет! Я ассистент WeReplyFirst — и сам работаю на этом продукте. Как я отвечаю вам, так буду отвечать вашим клиентам. Спрашивайте.",
      chips: ["Что ты умеешь?", "Сколько стоит?", "А ты не наврёшь клиенту?", "Говоришь по-казахски?"],
    },
  };

  // ---------- rendering ----------
  const root = document.querySelector<HTMLElement>("[data-chat]")!;
  const log = root.querySelector<HTMLElement>("[data-log]")!;
  const chipsEl = root.querySelector<HTMLElement>("[data-chips]")!;
  const form = root.querySelector<HTMLFormElement>("[data-form]")!;
  const input = root.querySelector<HTMLInputElement>("[data-input]")!;
  const think = root.querySelector<HTMLInputElement>("[data-think]")!;
  const nameEl = root.querySelector<HTMLElement>("[data-name]")!;
  const statusEl = root.querySelector<HTMLElement>("[data-status]")!;
  const owner = root.querySelector<HTMLElement>("[data-owner]")!;
  const ownerText = root.querySelector<HTMLElement>("[data-owner-text]")!;
  const ownerActions = root.querySelector<HTMLElement>("[data-owner-actions]")!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-mode]")];

  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (t: number) => new Promise((res) => setTimeout(res, reduce ? 0 : t));
  let mode: Mode = "client";
  let busy = false;
  let touched = false;
  let epoch = 0; // bumps on mode switch to cancel in-flight animations

  const el = (tag: string, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  };
  const scrollDown = () => log.scrollTo({ top: log.scrollHeight, behavior: reduce ? "auto" : "smooth" });

  think.addEventListener("change", () => root.classList.toggle("no-think", !think.checked));

  function setChips(list: string[] = []) {
    chipsEl.replaceChildren(
      ...list.map((c, i) => {
        const btn = el("button", "chip", c) as HTMLButtonElement;
        btn.type = "button";
        btn.style.setProperty("--i", String(i));
        btn.addEventListener("click", () => send(c));
        return btn;
      }),
    );
  }

  function userBubble(text: string) {
    const row = el("div", "msg user");
    if (/^голосовое/i.test(text)) {
      const v = el("div", "bubble voice");
      v.append(el("span", "play", "▶"));
      const wave = el("span", "wave");
      for (let i = 0; i < 26; i++) {
        const bar = el("i");
        bar.style.height = `${20 + Math.abs(Math.sin(i * 1.7)) * 80}%`;
        wave.append(bar);
      }
      v.append(wave, el("span", "dur", "0:04"));
      row.append(v);
    } else {
      row.append(el("div", "bubble", text));
    }
    log.append(row);
    scrollDown();
  }

  async function botReply(rep: Reply, my: number) {
    const row = el("div", "msg bot");
    log.append(row);

    if (rep.trace.length) {
      const tr = el("div", "trace");
      const head = el("div", "trace-head");
      head.append(el("span", "spark"), el("span", "", "думает"));
      tr.append(head);
      row.append(tr);
      scrollDown();
      for (const t of rep.trace) {
        await wait(170 + Math.random() * 160);
        if (my !== epoch) return;
        if ("route" in t) {
          const line = el("div", "t-route");
          const chip = el("span", "route", t.label);
          chip.dataset.r = t.route;
          line.append(chip);
          tr.append(line);
        } else {
          const line = el("div", "t-kv");
          line.append(el("span", "k", t.k), el("span", "v", t.v));
          tr.append(line);
        }
        scrollDown();
      }
      head.lastElementChild!.textContent = "решение";
      tr.classList.add("done");
    }

    const typing = el("div", "bubble typing");
    typing.append(el("i"), el("i"), el("i"));
    row.append(typing);
    scrollDown();
    await wait(450 + Math.min(rep.text.length * 6, 700));
    if (my !== epoch) return;

    const bubble = el("div", "bubble");
    typing.replaceWith(bubble);
    const words = rep.text.split(" ");
    for (let i = 0; i < words.length; i++) {
      bubble.textContent = words.slice(0, i + 1).join(" ");
      if (i % 3 === 0) scrollDown();
      await wait(22);
      if (my !== epoch) return;
    }
    scrollDown();

    if (rep.owner) {
      await wait(900);
      if (my !== epoch) return;
      showOwner(rep.owner, my);
    } else {
      setChips(rep.chips);
    }
  }

  function showOwner(o: NonNullable<Reply["owner"]>, my: number) {
    ownerText.textContent = o.text;
    ownerActions.replaceChildren(
      ...o.answers.map((a) => {
        const btn = el("button", "o-btn", a.label) as HTMLButtonElement;
        btn.type = "button";
        btn.addEventListener("click", async () => {
          hideOwner();
          if (my !== epoch) return;
          busy = true;
          setChips([]);
          await wait(500);
          await botReply(a.reply, my);
          if (my === epoch) busy = false;
        });
        return btn;
      }),
    );
    owner.hidden = false;
    root.classList.add("owner-open");
    scrollDown();
    requestAnimationFrame(() => owner.classList.add("show"));
    setChips([]);
    statusEl.textContent = "ждёт ответа владельца…";
  }

  function hideOwner() {
    owner.classList.remove("show");
    owner.hidden = true;
    root.classList.remove("owner-open");
    statusEl.textContent = "ассистент WeReplyFirst · онлайн";
  }

  async function send(text: string) {
    const t = text.trim();
    if (!t || busy) return;
    touched = true;
    busy = true;
    hideOwner();
    setChips([]);
    userBubble(t);
    // Every await below re-checks the epoch: a tab switch must cancel this reply, and only
    // the current generation may release `busy`.
    const my = epoch;
    const m = mode;
    await wait(350);
    if (my !== epoch) return;

    if (m === "product") {
      const rep = productReply(t);
      if (rep === "switch") {
        await botReply(
          { trace: [r("template"), kv("действие", "переключить на демо-салон")], text: "Переключаю на демо-салон «Люмен» — представьте, что вы его клиент." },
          my,
        );
        await wait(700);
        if (my === epoch) setMode("client");
        return;
      }
      await botReply(rep, my);
    } else {
      await botReply(clientReply(t), my);
    }
    if (my === epoch) busy = false;
  }

  function setMode(m: Mode) {
    epoch++;
    mode = m;
    busy = false;
    b = {};
    hideOwner();
    tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.mode === m)));
    nameEl.textContent = m === "client" ? "Салон «Люмен»" : "WeReplyFirst";
    input.placeholder = m === "client" ? "Напишите как клиент…" : "Спросите о WeReplyFirst…";
    log.replaceChildren();
    const g = GREETING[m];
    const row = el("div", "msg bot");
    row.append(el("div", "bubble", g.text));
    log.append(row);
    setChips(g.chips);
  }

  tabs.forEach((t) => t.addEventListener("click", () => setMode(t.dataset.mode as Mode)));
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const v = input.value;
    input.value = "";
    send(v);
  });

  setMode("client");

  // Autoplay one exchange when the chat first comes into view, unless the visitor already started.
  const auto = new IntersectionObserver(
    (entries) => {
      if (!entries[0].isIntersecting) return;
      auto.disconnect();
      setTimeout(() => {
        if (!touched && mode === "client") send("Есть время завтра вечером?");
      }, 1400);
    },
    { threshold: 0.5 },
  );
  auto.observe(root);
</script>

