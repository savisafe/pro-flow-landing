---
import { FAQ } from "../data/faq";
---

<section class="section faq" id="faq">
  <div class="container narrow">
    <div class="section-head center reveal">
      <span class="eyebrow">FAQ</span>
      <h2 class="display">Частые <span class="grad">вопросы</span></h2>
    </div>
    <div class="list">
      {
        FAQ.map((f, i) => (
          <details class="item reveal" style={`--d:${i * 0.04}s`} open={i === 0}>
            <summary>
              <h3>{f.q}</h3>
              <span class="pm" aria-hidden="true" />
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .narrow {
    max-width: 860px;
  }
  .list {
    display: grid;
    gap: 10px;
  }
  .item {
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.025);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background 0.3s, box-shadow 0.3s;
  }
  .item[open] {
    background: rgba(139, 108, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(139, 108, 255, 0.35);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  h3 {
    margin: 0;
    font-size: 17.5px;
    font-weight: 600;
  }
  .pm {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .pm::before,
  .pm::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.5px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    transition: transform 0.3s var(--ease-out);
  }
  .pm::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .item[open] .pm::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .item[open] .pm {
    background: var(--lime);
  }
  .item[open] .pm::before,
  .item[open] .pm::after {
    background: #0a0c12;
  }
  p {
    margin: 0;
    padding: 0 24px 22px;
    color: var(--muted);
  }
</style>
