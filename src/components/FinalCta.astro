---
import { PRICE, SALES_BOT_URL, SIGNUP_URL } from "../config";
---

<section class="section final" id="start">
  <div class="core" aria-hidden="true">
    <div class="orbit o1"></div>
    <div class="orbit o2"></div>
    <div class="orbit o3"></div>
    <div class="nucleus"></div>
  </div>

  <div class="container content reveal">
    <span class="eyebrow">Ранний доступ</span>
    <h2 class="display big">
      Выпустите ассистента<br /><span class="grad">в ночную смену</span>
    </h2>
    <p class="lead">
      {PRICE.trialDays} дней бесплатно. Подключим и настроим вместе с вами — понравится, продолжите по подписке; нет — ничего
      не платите.
    </p>
    <div class="actions">
      <a href={SIGNUP_URL} class="btn btn-primary">Создать ассистента <span class="arrow">→</span></a>
      <a href={SALES_BOT_URL} target="_blank" rel="noopener" class="btn btn-ghost">Написать нашему ассистенту ↗</a>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-block: clamp(120px, 16vw, 200px);
  }
  .content {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .big {
    font-size: clamp(38px, 6.4vw, 84px);
  }
  .lead {
    margin: 0 auto;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }

  .core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(900px, 140vw);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0.8;
  }
  .nucleus {
    position: absolute;
    inset: 38%;
    border-radius: 50%;
    background: radial-gradient(circle at 45% 40%, rgba(255, 255, 255, 0.9), rgba(214, 255, 61, 0.5) 18%, rgba(43, 228, 255, 0.25) 40%, transparent 70%);
    filter: blur(20px);
    animation: pulse 5s ease-in-out infinite;
  }
  .orbit {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    border: 1px solid rgba(139, 108, 255, 0.35);
    transform-style: preserve-3d;
  }
  .orbit::after {
    content: "";
    position: absolute;
    top: -5px;
    left: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 20px 4px var(--cyan);
  }
  .o1 { animation: o1 14s linear infinite; }
  .o2 { inset: 20%; border-color: rgba(43, 228, 255, 0.3); animation: o2 10s linear infinite; }
  .o2::after { background: var(--lime); box-shadow: 0 0 20px 4px var(--lime); }
  .o3 { inset: 0; border-color: rgba(255, 91, 216, 0.18); animation: o3 22s linear infinite; }
  .o3::after { background: var(--pink); box-shadow: 0 0 20px 4px var(--pink); }

  @media (max-width: 480px) {
    .actions .btn { width: 100%; }
  }

  @keyframes o1 { from { transform: rotateX(70deg) rotateZ(0); } to { transform: rotateX(70deg) rotateZ(360deg); } }
  @keyframes o2 { from { transform: rotateX(60deg) rotateY(30deg) rotateZ(0); } to { transform: rotateX(60deg) rotateY(30deg) rotateZ(-360deg); } }
  @keyframes o3 { from { transform: rotateX(75deg) rotateY(-25deg) rotateZ(0); } to { transform: rotateX(75deg) rotateY(-25deg) rotateZ(360deg); } }
  @keyframes pulse { 50% { transform: scale(1.15); opacity: 0.8; } }
</style>
