---
import { PRICE } from "../config";

const night = [
  { t: "21:47", q: "Сколько стоит маникюр?", ok: "назвал цену из прайса" },
  { t: "23:12", q: "Есть окно завтра после работы?", ok: "записал на 19:30" },
  { t: "01:30", q: "Можно перенести запись на субботу?", ok: "перенёс в журнале CRM" },
  { t: "07:55", q: "А скидки бывают?", ok: "спросил владельца, ответил" },
];
---

<section class="section night" id="night">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Онлайн 24/7</span>
      <h2 class="display">Менеджер, который <span class="grad">всегда на связи</span></h2>
      <p class="lead">
        Клиенты пишут вечером, ночью, в выходные и пока вы заняты с другим клиентом. Если не ответить сразу, они
        записываются туда, где ответили первыми. pro-flow отвечает за секунды — в любое время.
      </p>
    </div>

    <div class="timeline">
      <div class="rail" aria-hidden="true"><span></span></div>
      {
        night.map((n, i) => (
          <article class="slot card reveal" style={`--d:${i * 0.08}s`}>
            <time class="t mono">{n.t}</time>
            <p class="q">«{n.q}»</p>
            <div class="row bad">
              <span class="tag">без ассистента</span>
              <span>ответ утром — клиент ушёл</span>
            </div>
            <div class="row good">
              <span class="tag">pro-flow</span>
              <span>за секунды · {n.ok}</span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="calc card reveal" id="calculator" data-calc data-price={PRICE.monthly}>
      <div class="calc-in">
        <h3 class="display h3">Сколько вы теряете?</h3>
        <p class="hint">
          Вы сосредоточены на работе — менеджер закрывает запись. Подвиньте ползунки под свой бизнес и посчитайте, сколько
          клиентов уходит, пока ответить некому.
        </p>

        <label class="field">
          <span class="lbl">Сообщений от клиентов в день <output data-out="msgs">20</output></span>
          <input type="range" min="3" max="120" value="20" data-in="msgs" />
        </label>
        <label class="field">
          <span class="lbl">Из них вне рабочего времени <output data-out="off">35%</output></span>
          <input type="range" min="5" max="80" value="35" data-in="off" />
        </label>
        <label class="field">
          <span class="lbl">Сколько из них можно было записать <output data-out="conv">25%</output></span>
          <input type="range" min="5" max="70" value="25" data-in="conv" />
        </label>
        <label class="field">
          <span class="lbl">Средний чек <output data-out="check">9 000 ₸</output></span>
          <input type="range" min="2000" max="60000" step="500" value="9000" data-in="check" />
        </label>
      </div>

      <div class="calc-out">
        <span class="mono cap">уходит к конкурентам в месяц</span>
        <div class="big display" data-lost>0 ₸</div>
        <div class="sub" data-clients>0 клиентов, которых можно было записать</div>
        <div class="vs">
          <div>
            <span class="mono cap">pro-flow</span>
            <b>25 000 ₸ / мес</b>
          </div>
          <div>
            <span class="mono cap">окупается с</span>
            <b data-payback>3-го клиента</b>
          </div>
        </div>
        <p class="slogan">Пока вы работаете — записи идут.</p>
        <a href="#start" class="btn btn-primary">Вернуть этих клиентов <span class="arrow">→</span></a>
        <p class="note">Оценка по вашим вводным. Пробный период — {PRICE.trialDays} дней — покажет реальные цифры на ваших клиентах.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-calc]");
  if (root) {
    const PRICE = Number(root.dataset.price);
    const num = (n: number) => new Intl.NumberFormat("ru-RU").format(n).replace(/\u00a0/g, " ");
    const plural = (n: number, one: string, few: string, many: string) =>
      n % 10 === 1 && n % 100 !== 11 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? few : many;
    const fmt = (n: number) => `${new Intl.NumberFormat("ru-RU").format(Math.round(n)).replace(/ /g, " ")} ₸`;
    const get = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!.value);
    const out = (k: string, v: string) => (root.querySelector(`[data-out="${k}"]`)!.textContent = v);
    const lostEl = root.querySelector("[data-lost]")!;
    let shown = 0;
    let raf = 0;

    const animateTo = (target: number) => {
      cancelAnimationFrame(raf);
      const from = shown;
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 500);
        shown = from + (target - from) * (1 - Math.pow(1 - p, 3));
        lostEl.textContent = fmt(shown);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    const ordinal = (n: number) => `${n}-го клиента`;

    const update = () => {
      const msgs = get("msgs");
      const off = get("off");
      const conv = get("conv");
      const check = get("check");
      out("msgs", String(msgs));
      out("off", `${off}%`);
      out("conv", `${conv}%`);
      out("check", fmt(check));
      // whole clients only — the sum must equal clients × check on screen
      const clients = Math.round(msgs * 30 * (off / 100) * (conv / 100));
      root.querySelector("[data-clients]")!.textContent =
        `${num(clients)} ${plural(clients, "клиент, которого", "клиента, которых", "клиентов, которых")} можно было записать`;
      root.querySelector("[data-payback]")!.textContent = ordinal(Math.max(1, Math.ceil(PRICE / check)));
      animateTo(clients * check);
      root.querySelectorAll<HTMLInputElement>("input[type=range]").forEach((i) => {
        const p = ((Number(i.value) - Number(i.min)) / (Number(i.max) - Number(i.min))) * 100;
        i.style.setProperty("--p", `${p}%`);
      });
    };
    root.addEventListener("input", update);
    update();
  }
</script>

<style>
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 28px;
  }
  .rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 34px;
    height: 1px;
    background: var(--line-strong);
  }
  .rail span {
    position: absolute;
    top: -1px;
    left: 0;
    width: 120px;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, transparent, var(--lime), transparent);
    box-shadow: 0 0 16px var(--lime);
    animation: run 4s linear infinite;
  }
  .slot {
    padding: 22px;
  }
  .t {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--cyan);
    background: rgba(43, 228, 255, 0.08);
    box-shadow: inset 0 0 0 1px rgba(43, 228, 255, 0.3);
  }
  .q {
    margin: 16px 0 18px;
    font-size: 17px;
    font-weight: 500;
    min-height: 54px;
  }
  .row {
    display: grid;
    gap: 3px;
    padding: 10px 0;
    border-top: 1px dashed var(--line);
    font-size: 14px;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .bad {
    color: var(--dim);
  }
  .bad span:last-child {
    text-decoration: line-through;
    text-decoration-color: rgba(255, 91, 120, 0.6);
  }
  .bad .tag {
    color: #ff5b78;
  }
  .good .tag {
    color: var(--lime);
  }

  .calc {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
  }
  .calc-in {
    padding: clamp(24px, 4vw, 44px);
  }
  .h3 {
    font-size: clamp(24px, 3vw, 34px);
  }
  .hint {
    color: var(--muted);
    margin: 10px 0 28px;
  }
  .field {
    display: grid;
    gap: 10px;
    margin-bottom: 22px;
  }
  .lbl {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 15px;
    color: var(--muted);
  }
  output {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--ink);
  }
  input[type="range"] {
    --p: 50%;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--violet), var(--cyan) var(--p), rgba(255, 255, 255, 0.1) var(--p));
    outline: none;
    cursor: pointer;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 4px rgba(43, 228, 255, 0.35),
      0 0 18px rgba(43, 228, 255, 0.8);
  }
  input[type="range"]::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 4px rgba(43, 228, 255, 0.35),
      0 0 18px rgba(43, 228, 255, 0.8);
  }

  .calc-out {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: clamp(24px, 4vw, 44px);
    background:
      radial-gradient(400px 300px at 70% 0%, rgba(214, 255, 61, 0.12), transparent 70%),
      rgba(0, 0, 0, 0.25);
    border-left: 1px solid var(--line);
  }
  .cap {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .big {
    font-size: clamp(42px, 6vw, 72px);
    color: var(--lime);
    text-shadow: 0 0 40px rgba(214, 255, 61, 0.35);
    font-variant-numeric: tabular-nums;
  }
  .sub {
    color: var(--muted);
  }
  .vs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 8px 0 10px;
  }
  .vs > div {
    display: grid;
    gap: 4px;
    padding: 14px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .vs b {
    font-size: 17px;
  }
  .calc-out .btn {
    align-self: flex-start;
  }
  .slogan {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .note {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--dim);
  }

  @media (max-width: 1000px) {
    .timeline {
      grid-template-columns: 1fr 1fr;
    }
    .rail {
      display: none;
    }
    .calc {
      grid-template-columns: 1fr;
    }
    .calc-out {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 560px) {
    .timeline {
      grid-template-columns: 1fr;
    }
    .q {
      min-height: 0;
    }
    .calc-out .btn {
      align-self: stretch;
    }
  }

  @keyframes run {
    from { transform: translateX(-120px); }
    to { transform: translateX(calc(min(1220px, 100vw))); }
  }
</style>
