---
// Language dropdown. Add a locale here once its pages exist — the list grows, the header doesn't.
const LOCALES = [
  { code: "ru", label: "Русский", href: "/", ready: true },
  { code: "kk", label: "Қазақша", href: "/kk/", ready: false },
  { code: "en", label: "English", href: "/en/", ready: false },
];
const current = LOCALES[0];
---

<details class="lang" data-lang>
  <summary aria-label={`Язык: ${current.label}`}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path>
    </svg>
    <span class="code">{current.code.toUpperCase()}</span>
    <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
  </summary>
  <ul class="menu" role="list">
    {
      LOCALES.map((l) =>
        l.ready ? (
          <li>
            <a href={l.href} hreflang={l.code} aria-current={l.code === current.code ? "true" : undefined}>
              {l.label}
              {l.code === current.code && <span class="tick">✓</span>}
            </a>
          </li>
        ) : (
          <li>
            <span class="off">
              {l.label}
              <span class="soon">скоро</span>
            </span>
          </li>
        ),
      )
    }
  </ul>
</details>

<script>
  const d = document.querySelector<HTMLDetailsElement>("[data-lang]");
  if (d) {
    document.addEventListener("click", (e) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && d.open) {
        d.open = false;
        d.querySelector("summary")?.focus();
      }
    });
  }
</script>

<style>
  .lang {
    position: relative;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    padding: 0 12px;
    border-radius: 999px;
    list-style: none;
    cursor: pointer;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: color 0.2s, background 0.2s;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  .lang[open] summary {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.08);
  }
  .code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
  }
  .chev {
    transition: transform 0.25s var(--ease-out);
  }
  .lang[open] .chev {
    transform: rotate(180deg);
  }
  .menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 180px;
    margin: 0;
    padding: 6px;
    list-style: none;
    border-radius: 16px;
    background: rgba(12, 14, 32, 0.96);
    backdrop-filter: blur(18px);
    box-shadow:
      inset 0 0 0 1px var(--line-strong),
      0 24px 60px -12px rgba(0, 0, 0, 0.7);
    animation: drop 0.22s var(--ease-out);
    z-index: 50;
  }
  .menu a,
  .off {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 12px;
    border-radius: 10px;
    font-size: 14.5px;
  }
  .menu a:hover {
    background: rgba(255, 255, 255, 0.07);
  }
  .tick {
    color: var(--lime);
  }
  .off {
    color: var(--dim);
    cursor: default;
  }
  .soon {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @keyframes drop {
    from { opacity: 0; transform: translateY(-6px); }
  }
</style>
